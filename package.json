{
  "name": "dj-desktop",
  "version": "3.14.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node app/scripts/dev.js",
    "start": "node app/scripts/dev.js",
    "build": "npm --prefix app run build && node -e \"const fs=require('fs'); fs.cpSync('app/dist', 'dist', {recursive:true, force:true});\"",
