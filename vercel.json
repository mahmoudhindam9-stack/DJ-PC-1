{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    },
    "api/albumaty/stream.js": {
      "maxDuration": 60
    },
    "api/albumaty/download.js": {
      "maxDuration": 60
    },
    "api/online/stream.js": {
      "maxDuration": 60
    },
    "api/online/download.js": {
      "maxDuration": 60
    },
    "api/local-music/generate.js": {
      "maxDuration": 60
    }
  }
}
